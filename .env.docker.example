# Copy this file to .env and fill in the values before running docker-compose.

# PostgreSQL
POSTGRES_DB=kb
POSTGRES_USER=kb
POSTGRES_PASSWORD=change_me_strong_password

# Application
DATABASE_URL=postgresql://kb:change_me_strong_password@db:5432/kb
SESSION_SECRET=change_me_at_least_32_chars_long_random_string

# File storage (mapped to the Docker volume; matches FILE_STORAGE_PATH in docker-compose.yml)
# No need to change this unless you mount a custom path.
# FILE_STORAGE_PATH=/data/uploads
