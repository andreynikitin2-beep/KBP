# Скопируйте этот файл в .env и заполните значения перед запуском.
#
# Быстрый старт:
#   cp .env.docker.example .env
#   nano .env                    # заполните пароли
#   chmod +x generate-certs.sh
#   ./generate-certs.sh          # сгенерировать самоподписанный сертификат (1 раз)
#   docker compose up -d         # запустить всё
#
# Портал будет доступен по адресу:  https://<сервер>:3710

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=kb
POSTGRES_USER=kb
# Задайте надёжный пароль (минимум 16 символов):
POSTGRES_PASSWORD=change_me_strong_password

# ── Приложение ────────────────────────────────────────────────────────────────
# Строка подключения к БД (хост "db" — имя сервиса в docker-compose):
DATABASE_URL=postgresql://kb:change_me_strong_password@db:5432/kb

# Секрет для подписи сессий — случайная строка минимум 32 символа:
SESSION_SECRET=change_me_at_least_32_chars_long_random_string

# ── Файловое хранилище ────────────────────────────────────────────────────────
# Путь внутри контейнера app (смонтирован как Docker-том "uploads").
# Менять не нужно, если вы не переопределяете том в docker-compose.yml.
# FILE_STORAGE_PATH=/data/uploads

# ── Резервные копии БД ────────────────────────────────────────────────────────
# Сервис backup запускает pg_dump каждый день в 03:00 и сохраняет сжатые
# дампы в директорию ./backups/ на хосте.
#
# Сколько дней хранить дампы (по умолчанию 7):
# BACKUP_RETAIN_DAYS=7
#
# Лог последнего запуска: ./backups/backup.log
#
# ── Восстановление из резервной копии ─────────────────────────────────────────
# 1. Скопируйте нужный дамп с хоста на сервер (или он уже есть в ./backups/).
# 2. Остановите приложение, чтобы не было активных подключений:
#      docker compose stop app
# 3. Восстановите дамп:
#      gunzip -c ./backups/<имя_файла>.sql.gz \
#        | docker compose exec -T db \
#            psql -U kb kb
# 4. Запустите приложение снова:
#      docker compose start app
